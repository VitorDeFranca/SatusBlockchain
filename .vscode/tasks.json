{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SatusBlockchain.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/SatusBlockchain.Node/SatusBlockchain.Node.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/SatusBlockchain.Node/SatusBlockchain.Node.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test: unidade",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/SatusBlockchain.Node.Tests/SatusBlockchain.Node.Tests.csproj",
                "--filter",
                "FullyQualifiedName~Tests.Unit"
            ]
        },
        {
            "label": "test: integração",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/SatusBlockchain.Node.Tests/SatusBlockchain.Node.Tests.csproj",
                "--filter",
                "FullyQualifiedName~Tests.Integration"
            ]
        }
    ]
}