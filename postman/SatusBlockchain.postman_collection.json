    {
      "name": "18. Jaeger busca trace de mineracao",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A API v3 do Jaeger exige a janela de busca em RFC3339 (UTC).",
              "const fmt = d => d.toISOString().replace(/\\.\\d{3}Z$/, 'Z');",
              "pm.variables.set('startTimeMin', fmt(new Date(Date.now() - 60 * 60 * 1000)));",
              "pm.variables.set('startTimeMax', fmt(new Date()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "const r = pm.response.json();",
              "pm.test('sem erro da API', () => pm.expect(r.error).to.be.undefined);",
              "",
              "// Formato OTLP: result.resourceSpans[].scopeSpans[].spans[]",
              "const spans = [];",
              "((r.result || {}).resourceSpans || []).forEach(rs => {",
              "    const svc = (rs.resource.attributes || []).find(a => a.key === 'service.name');",
              "    const nome = svc ? svc.value.stringValue : 'desconhecido';",
              "    (rs.scopeSpans || []).forEach(ss => (ss.spans || []).forEach(sp => spans.push({ nome: sp.name, service: nome })));",
              "});",
              "",
              "pm.test('ha spans (mine antes e aguarde ~3s se vazio)', () => {",
              "    pm.expect(spans.length, 'sem spans: rode o request 7 e rode de novo').to.be.at.least(1);",
              "});",
              "",
              "if (spans.length > 0) {",
              "    pm.test('inclui span de HTTP de entrada (POST)', () => {",
              "        pm.expect(spans.some(s => (s.nome || '').includes('POST'))).to.be.true;",
              "    });",
              "    const servicos = [...new Set(spans.map(s => s.service))];",
              "    if (servicos.length > 1) {",
              "        pm.test('trace cruzou mais de um no (propagacao do traceparent)', () => {",
              "            pm.expect(servicos.length).to.be.at.least(2);",
              "        });",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{jaegerUrl}}/api/v3/traces?query.service=node1&query.operation_name=POST%20/blocks/mine&query.startTimeMin={{startTimeMin}}&query.startTimeMax={{startTimeMax}}&query.limit=5",
          "host": ["{{jaegerUrl}}"],
          "path": ["api", "v3", "traces"],
          "query": [
            {
              "key": "query.service",
              "value": "node1"
            },
            {
              "key": "query.operation_name",
              "value": "POST /blocks/mine"
            },
            {
              "key": "query.startTimeMin",
              "value": "{{startTimeMin}}"
            },
            {
              "key": "query.startTimeMax",
              "value": "{{startTimeMax}}"
            },
            {
              "key": "query.limit",
              "value": "5"
            }
          ]
        },
        "description": "GET /api/v3/traces (Jaeger v2) — traces do POST /blocks/mine do node1 na ultima hora (a janela de tempo e calculada no pre-request script, pois a API v3 exige startTimeMin/Max em RFC3339; o filtro operation_name evita os traces de scrape do Prometheus afogarem o resultado). Depois de minerar (request 7) o trace contem: o span de entrada POST /blocks/mine, o span proprio 'mine' e — pela propagacao do traceparent — os POST /blocks/receive nos nodes 2 e 3 na MESMA arvore. Abra no UI: http://localhost:16686/trace/<traceId>. Batch OTLP com delay de 1s; se vier vazio, aguarde e rode de novo."
      }
    },
